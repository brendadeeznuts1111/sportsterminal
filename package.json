{
  "name": "sportsterminal",
  "version": "0.2.0",
  "description": "Sports Terminal v5.32 - Player 360 real-data contracts, coverage mapping, Buckeye ingestion, odds grid, patterns, and risk management",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "bun run --cwd backend dev",
    "start": "bun run --cwd backend start",
    "test": "bun run --cwd backend test",
    "build": "bun run --cwd backend build",
    "serve": "bun run scripts/serve-frontend.ts",
    "backend:dev": "bun --watch backend/src/index.ts",
    "backend:start": "bun backend/src/index.ts",
    "db:reset": "bun run scripts/db-reset.ts",
    "db:migrate": "bun run --cwd backend scripts/migrate.ts",
    "probe:player360": "bun run --cwd backend scripts/probe-player360.ts",
    "backfill:hierarchy": "bun run --cwd backend scripts/backfill-hierarchy.ts",
    "integrity:check": "bun run --cwd . backend/scripts/integrity-check.ts",
    "artifacts:check": "bun run scripts/check-sensitive-artifacts.ts",
    "proxy:dev": "bun --watch proxy-enhanced.ts",
    "proxy:start": "bun proxy-enhanced.ts",
    "proxy:build": "bun build proxy-enhanced.ts --compile --outfile dist/proxy-server",
    "smoke:proxy": "bun run scripts/smoke-proxy.ts",
    "smoke:backend": "bun run scripts/smoke-backend.ts",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "status": "bun run scripts/status.js",
    "stop": "bun run scripts/stop.js",
    "clean-start": "bun run stop && bun run dev",
    "dev:port": "bun run scripts/dev-port.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@types/node": "^25.6.2",
    "bun-types": "^1.3.13"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
