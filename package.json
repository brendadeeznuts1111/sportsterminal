{
  "name": "sportsterminal",
  "version": "0.2.0",
  "description": "Sports Terminal v5.2 - Buckeye PPH integration, odds grid, and risk management",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "bun run --cwd backend dev",
    "start": "bun run --cwd backend start",
    "test": "bun run --cwd backend test",
    "build": "bun run --cwd backend build",
    "serve": "bun run scripts/serve-frontend.ts",
    "db:reset": "rm -f backend/data/terminal.db && echo 'Database reset. Run bun run dev to recreate.'",
    "db:migrate": "bun run --cwd backend scripts/migrate.ts",
    "backfill:hierarchy": "bun run --cwd backend scripts/backfill-hierarchy.ts",
    "status": "bun run scripts/status.js",
    "stop": "bun run scripts/stop.js",
    "clean-start": "bun run stop && bun run dev",
    "dev:port": "bun run scripts/dev-port.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0"
  }
}
