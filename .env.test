# .env.test — Test environment (isolated, no real API calls)
# Loaded for `bun test` only

# ==========================================
# TEST API KEY
# ==========================================
PROXY_API_KEY=test-key-123

# ==========================================
# TEST OVERRIDES
# ==========================================
PROXY_PRODUCTION=false
DEMO_MODE=true
ENABLE_METRICS=false
ENABLE_REQUEST_LOGGING=false
ENABLE_AUTO_RETRY=false
ENABLE_RATE_LIMITING=false
ENABLE_WS_BATCHING=false
ENABLE_TOKEN_MEM_CACHE=false
ENABLE_MEMORY_CACHE=false
ENABLE_RESPONSE_NORMALIZE=false
ENABLE_REQUEST_DEDUPE=false
ENABLE_IDEMPOTENCY=false
ENABLE_RISK_ENGINE=false
ENABLE_ANALYTICS=false
ENABLE_ADMIN_API=false
ENABLE_STREAM_MODE=false
ENABLE_TOKEN_EXPIRY_CHECK=false
ENABLE_WS_VALIDATION=false
ENABLE_WS_CLIENT_BATCHING=false
ENABLE_JWT_AUTH=false
ENABLE_OTEL=false
ENABLE_RESPONSE_COMPRESSION=false
ENABLE_WS_COMPRESSION=false
ENABLE_TOKEN_PRE_RENEWAL=false

# ==========================================
# TEST DATABASE (in-memory, no file lock)
# ==========================================
DB_PATH=:memory:

# ==========================================
# TEST URLS (no real Buckeye calls)
# ==========================================
BUCKEYE_BASE_URL=http://localhost:9999
PROXY_INTERNAL_URL=http://localhost:9999
VITE_BACKEND_URL=http://localhost:9999
VITE_WS_URL=ws://localhost:9999
