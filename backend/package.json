{
  "name": "sportsterminal-backend",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "lint": "eslint src/ --max-warnings 50",
    "typecheck": "tsc --noEmit",
    "probe:player360": "bun run scripts/probe-player360.ts",
    "backfill:hierarchy": "bun run scripts/backfill-hierarchy.ts"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "bun-types": "latest",
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.2"
  }
}
