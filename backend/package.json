{
  "name": "sportsterminal-backend",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test:suite": "bun --config=../bunfig.test.toml --bun test tests/",
    "test:parallel": "bun --config=../bunfig.test.toml --bun test --parallel tests/",
    "lint": "eslint src/ --max-warnings 500",
    "lint:strict": "eslint src/ --max-warnings 50",
    "typecheck": "tsc --noEmit",
    "assess:data-infill": "bun run scripts/assess-data-infill-v3.ts",
    "probe:player360": "bun run scripts/probe-player360.ts",
    "backfill:hierarchy": "bun run scripts/backfill-hierarchy.ts",
    "ingest:seed": "bun run scripts/ingest-seed-data.ts",
    "telegram:setup": "bun run scripts/setup-telegram.ts"
  },
  "dependencies": {
    "fast-geoip": "^1.1.88",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "bun-types": "latest",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
