# Buckeye credentials are entered in Settings and stored in the OS vault.
# Do not put live Buckeye passwords or Cloudflare cookies in this file.
BUCKEYE_BASE_URL=https://fantasy402.com

# Backend Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-in-production-min-32-chars
NODE_ENV=development         # Set to 'production' to enable JWT + rate limiting

# Database
DATABASE_URL=sqlite:./data/terminal.db

# Polling
POLL_INTERVAL_MS=5000
TOKEN_RENEWAL_MINUTES=15
ACCESS_LOG_INTERVAL_MS=600000
AGENT_PERFORMANCE_INTERVAL_MS=900000
ODDS_POLL_INTERVAL_MS=30000
BOOK_HEALTH_INTERVAL_MS=60000

# Rate Limiting (HTTP)
RATE_LIMIT_MAX=100            # Max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000    # Window size in ms (default: 60s)
