# Buckeye credentials are entered in Settings and stored in the OS vault.
# Do not put live Buckeye passwords or Cloudflare cookies in this file.
BUCKEYE_BASE_URL=https://fantasy402.com

# Backend Server
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-in-production-min-32-chars
NODE_ENV=development         # Set to 'production' to enable JWT + rate limiting
# Optional local HTTP admin guard for sensitive mutations. Leave unset for local dev.
# ADMIN_API_TOKEN=

# Database (SQLite or Postgres)
# SQLite:  DATABASE_URL=sqlite:./data/terminal.db
# Postgres: DATABASE_URL=postgres://user:pass@localhost:5432/sportsterminal
DATABASE_URL=sqlite:./data/terminal.db

# Redis (optional — enables agent performance caching + pub/sub dashboards)
# REDIS_URL=redis://localhost:6379

# Internal enhanced proxy bridge
PROXY_INTERNAL_URL=http://localhost:3001
PROXY_API_KEY=dev-key-123

# Polling
POLL_INTERVAL_MS=5000
TOKEN_RENEWAL_MINUTES=15
ACCESS_LOG_INTERVAL_MS=600000
AGENT_PERFORMANCE_INTERVAL_MS=900000
ODDS_POLL_INTERVAL_MS=30000
BOOK_HEALTH_INTERVAL_MS=60000

# Rate Limiting (HTTP)
RATE_LIMIT_MAX=100            # Max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000    # Window size in ms (default: 60s)

# Root bunfig preload
PRELOAD_VERBOSE=true
PRELOAD_SQLITE_WAL=true
DEFAULT_FETCH_TIMEOUT_MS=30000
ENABLE_GLOBAL_FETCH_TIMEOUT=false
ENABLE_PRELOAD_LOG_DB=false

# Standalone enhanced proxy defaults (when running from repo root)
PROXY_PORT=3001
PROXY_PRODUCTION=false
DB_PATH=buckeye_cache.sqlite
ENABLE_METRICS=true
ENABLE_REQUEST_LOGGING=true
ENABLE_RESPONSE_COMPRESSION=false
ENABLE_WS_COMPRESSION=false
ENABLE_WS_BATCHING=false
ENABLE_AUTO_RETRY=true
ENABLE_RATE_LIMITING=true
ENABLE_MEMORY_CACHE=true
ENABLE_RESPONSE_NORMALIZE=true
ENABLE_REQUEST_DEDUPE=true
ENABLE_REQUEST_SAMPLING=true
ENABLE_WS_CLIENT_BATCHING=true
ENABLE_WS_VALIDATION=true
ENABLE_IDEMPOTENCY=true
DEMO_MODE=false
WS_BATCH_INTERVAL_MS=200
MAX_RETRIES=3
RETRY_BASE_MS=1000
