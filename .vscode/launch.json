{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bun: Dev (backend)",
      "type": "bun",
      "request": "launch",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": true
    },
    {
      "name": "Bun: Backend Start",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/index.ts",
      "cwd": "${workspaceFolder}/backend",
      "stopOnEntry": false,
      "watchMode": false
    },
    {
      "name": "Bun: Proxy Dev",
      "type": "bun",
      "request": "launch",
      "runtimeArgs": ["run", "proxy:dev"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": true
    },
    {
      "name": "Bun: Test Suite",
      "type": "bun",
      "request": "launch",
      "runtimeArgs": ["run", "test"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false
    },
    {
      "name": "Bun: Test Current File",
      "type": "bun",
      "request": "launch",
      "runtimeArgs": ["test", "${file}"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false
    },
    {
      "name": "Bun: Debug Current File",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false
    }
  ]
}
