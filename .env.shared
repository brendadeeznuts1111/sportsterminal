# .env.shared — Shared configuration for all environments
# Loaded first; overridden by .env.local or .env.production

# ==========================================
# PORTS
# ==========================================
PROXY_PORT=3001
BACKEND_PORT=3000

# ==========================================
# URLS
# ==========================================
BUCKEYE_BASE_URL=https://fantasy402.com
PROXY_INTERNAL_URL=http://localhost:3001
VITE_BACKEND_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ==========================================
# FEATURE FLAGS (safe defaults)
# ==========================================
DEMO_MODE=false
ENABLE_METRICS=true
ENABLE_REQUEST_LOGGING=true
ENABLE_AUTO_RETRY=true
ENABLE_RATE_LIMITING=false
ENABLE_WS_BATCHING=true
ENABLE_TOKEN_MEM_CACHE=true
ENABLE_MEMORY_CACHE=true
ENABLE_RESPONSE_NORMALIZE=true
ENABLE_REQUEST_DEDUPE=true
ENABLE_IDEMPOTENCY=false
ENABLE_RISK_ENGINE=true
ENABLE_ANALYTICS=true
ENABLE_ADMIN_API=false
ENABLE_STREAM_MODE=true
ENABLE_TOKEN_EXPIRY_CHECK=true
ENABLE_WS_VALIDATION=true
ENABLE_WS_CLIENT_BATCHING=true
ENABLE_JWT_AUTH=false
ENABLE_OTEL=false
ENABLE_RESPONSE_COMPRESSION=false
ENABLE_WS_COMPRESSION=false
ENABLE_TOKEN_PRE_RENEWAL=true

# ==========================================
# TUNABLES
# ==========================================
WS_BATCH_INTERVAL_MS=200
MAX_RETRIES=3
RETRY_BASE_MS=1000
SAMPLE_RATE=0.01
TOKEN_CACHE_TTL_MS=5000
MEMORY_CACHE_TTL_MS=2000
RATE_LIMIT_PER_MIN=60
TOKEN_RENEWAL_INTERVAL_MS=300000
TOKEN_RENEWAL_THRESHOLD_MS=600000
TOKEN_MAX_RENEWAL_ATTEMPTS=3

# ==========================================
# DATABASE
# ==========================================
DB_PATH=buckeye_cache.sqlite

# ==========================================
# DNS
# ==========================================
BUN_CONFIG_DNS_TIME_TO_LIVE_SECONDS=300